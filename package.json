{
  "name": "whatsapp-axi",
  "version": "0.1.0",
  "description": "Agent-ergonomic CLI and local daemon for WhatsApp accounts",
  "scripts": {
    "build": "tsc && chmod +x dist/bin/whatsapp-axi.js",
    "lint": "oxlint src bin test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JarvusInnovations/whatsapp-axi.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/JarvusInnovations/whatsapp-axi/issues"
  },
  "homepage": "https://github.com/JarvusInnovations/whatsapp-axi#readme",
  "type": "module",
  "bin": {
    "whatsapp-axi": "dist/bin/whatsapp-axi.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@toon-format/toon": "^4.4.0",
    "axi-sdk-js": "^0.1.14"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
